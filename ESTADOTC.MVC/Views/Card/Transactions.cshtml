@model Microsoft.FSharp.Collections.FSharpList<ESTADOTC.MVC.Models.TransactionViewModel>
@using System.Linq

@{
    ViewData["Title"] = "Historial de movimientos";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Historial de movimientos</h1>
            <p class="text-muted mb-0">
                Consulta todos los movimientos de tu tarjeta
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            ← Volver
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">

            @if (Model.Any())
            {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Fecha</th>
                            <th>Descripción</th>
                            <th>Tipo</th>
                            <th class="text-end px-4">Monto</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var transaction in Model)
                        {
                        <tr>
                            <td class="px-4">
                                @transaction.TransactionDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @transaction.Description
                            </td>

                            <td>
                                @if (transaction.TransactionType == "PURCHASE")
                                {
                                <span class="badge bg-danger">
                                    Compra
                                </span>
                                }
                                else
                                {
                                <span class="badge bg-success">
                                    Pago
                                </span>
                                }
                            </td>

                            <td class="text-end px-4 fw-bold">
                                @transaction.Amount.ToString("C")
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
            }
            else
            {
            <div class="p-4 text-center text-muted">
                No existen movimientos registrados.
            </div>
            }

        </div>
    </div>

</div>