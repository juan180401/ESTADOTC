@model ESTADOTC.MVC.Models.CardDashboardViewModel
@using System.Linq

@{
    ViewData["Title"] = "Estado de cuenta";
}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">Estado de cuenta</h1>
            <p class="text-muted mb-0">
                Información financiera de tu tarjeta
            </p>
        </div>

        <div class="mt-3">
            <a asp-action="Purchase" class="btn btn-primary">
                + Registrar compra
            </a>
        </div>

        <div class="text-end">
            <span class="badge bg-primary fs-6">
                Tarjeta activa
            </span>
        </div>
    </div>

    <!-- Card information -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body p-4">

            <div class="row align-items-center">

                <div class="col-md-6">
                    <p class="text-muted mb-1">Tarjetahabiente</p>
                    <h3 class="fw-bold">@Model.Statement.HolderName</h3>

                    <p class="mb-0">
                        <span class="text-muted">Tarjeta:</span>
                        @Model.Statement.CardNumber
                    </p>
                </div>

                <div class="col-md-6 text-md-end mt-3 mt-md-0">
                    <p class="text-muted mb-1">Límite de crédito</p>

                    <h2 class="fw-bold">
                        @Model.Statement.CreditLimit.ToString("C")
                    </h2>
                </div>

            </div>

        </div>
    </div>

    <!-- Balance cards -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Saldo actual</p>

                    <h2 class="fw-bold">
                        @Model.Statement.CurrentBalance.ToString("C")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Límite de crédito</p>

                    <h2 class="fw-bold">
                        @Model.Statement.CreditLimit.ToString("C")
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <p class="text-muted mb-2">Crédito disponible</p>

                    <h2 class="fw-bold">
                        @Model.Statement.AvailableBalance.ToString("C")
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- Financial summary -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">
            <h4 class="fw-bold mb-0">
                Resumen financiero
            </h4>
        </div>

        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-3">
                    <p class="text-muted mb-1">
                        Interés bonificable
                    </p>

                    <h4 class="fw-bold">
                        @Model.FinancialSummary.BonifiableInterest.ToString("C")
                    </h4>
                </div>

                <div class="col-md-3">
                    <p class="text-muted mb-1">
                        Pago mínimo
                    </p>

                    <h4 class="fw-bold">
                        @Model.FinancialSummary.MinimumPayment.ToString("C")
                    </h4>
                </div>

                <div class="col-md-3">
                    <p class="text-muted mb-1">
                        Total a pagar
                    </p>

                    <h4 class="fw-bold">
                        @Model.FinancialSummary.TotalToPay.ToString("C")
                    </h4>
                </div>

                <div class="col-md-3">
                    <p class="text-muted mb-1">
                        Pago con interés
                    </p>

                    <h4 class="fw-bold">
                        @Model.FinancialSummary.CashPaymentWithInterest.ToString("C")
                    </h4>
                </div>

            </div>

        </div>
    </div>

    <!-- Monthly purchases -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white border-0 pt-4 px-4">
            <h4 class="fw-bold mb-0">
                Compras
            </h4>
        </div>

        <div class="card-body p-4">

            <div class="row">

                <div class="col-md-6">
                    <p class="text-muted mb-1">
                        Compras del mes actual
                    </p>

                    <h3 class="fw-bold">
                        @Model.MonthlyTotals.CurrentMonthPurchases.ToString("C")
                    </h3>
                </div>

                <div class="col-md-6">
                    <p class="text-muted mb-1">
                        Compras del mes anterior
                    </p>

                    <h3 class="fw-bold">
                        @Model.MonthlyTotals.PreviousMonthPurchases.ToString("C")
                    </h3>
                </div>

            </div>

        </div>
    </div>

    <!-- Transactions -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white border-0 pt-4 px-4">
            <h4 class="fw-bold mb-0">
                Movimientos del mes
            </h4>
        </div>

        <div class="card-body p-0">

            @if (Model.CurrentMonthTransactions.Any()) {

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="px-4">Fecha</th>
                            <th>Descripción</th>
                            <th>Tipo</th>
                            <th class="text-end px-4">Monto</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var transaction in Model.CurrentMonthTransactions)
                        {
                        <tr>

                            <td class="px-4">
                                @transaction.TransactionDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                @transaction.Description
                            </td>

                            <td>

                                @if (transaction.TransactionType == "PURCHASE")
                                {
                                <span class="badge bg-danger">
                                    Compra
                                </span>
                                }
                                else
                                {
                                <span class="badge bg-success">
                                    Pago
                                </span>
                                }

                            </td>

                            <td class="text-end px-4 fw-bold">
                                @transaction.Amount.ToString("C")
                            </td>

                        </tr>
                        }

                    </tbody>

                </table>

            </div>

            }
            else
            {
            <div class="p-4 text-center text-muted">
                No existen movimientos durante el mes actual.
            </div>
            }

        </div>
    </div>

</div>